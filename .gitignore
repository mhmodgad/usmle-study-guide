.venv/
__pycache__/
*.pyc
.DS_Store

# Built database (large; rebuildable from content)
data/*.db
data/*.db-wal
data/*.db-shm

# images you add with the in-app content editor
data/uploads/
# small browser-tab icon generated from your logo at runtime
data/app-icon-*.png

# Heavy / copyrighted data that should NOT be in git:
#   - topic images & videos
#   - the educational content the loader reads
# Everything else under local/ (css, icons, fonts, editor, logos) IS tracked.
local/assets/media/
local/content/
