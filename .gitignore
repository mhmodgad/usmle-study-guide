.venv/
__pycache__/
*.pyc
.DS_Store
# your hand-edited start/setup scripts, set aside by the updater
*.local-edit

# Your data: base.db (rebuildable content), user.db (your changes + study state),
# and the old single-file tempu.db kept after the upgrade
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db.pre-migration
data/*.migrating*

# files you add with the in-app editor (content-addressed) + local backup copies
data/blobs/
data/backup/
data/tools/
data/uploads/
data/uploads.migrated/
# small browser-tab icon generated from your logo at runtime
data/app-icon-*.png

# Heavy / copyrighted data that should NOT be in git:
#   - topic images & videos
#   - the educational content the loader reads
# Everything else under local/ (css, icons, fonts, editor, logos) IS tracked.
local/assets/media/
local/content/
